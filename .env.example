# Investor Scout environment variables.
# Copy to .env and fill in. Never commit the filled-in .env — it is gitignored.

# ---------------------------------------------------------------------------
# Required to start
# ---------------------------------------------------------------------------

# MySQL connection string. Holds the entire analysed catalogue, so this is the
# single most valuable piece of state in the system — back it up (see
# scripts/backup-database.sh and docs/RECOVERY.md).
DATABASE_URL=mysql://user:password@host:3306/database

# Secret used to sign session JWTs. Any long random string; rotating it logs
# every user out. Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# Required for listing ingestion
# ---------------------------------------------------------------------------

# RealtyAPI.io key for the realestate.com.au dataset, sent as the
# x-realtyapi-key header against https://realestateau.realtyapi.io
# Without it the stored catalogue still browses, but no new listings arrive and
# live search, deep scan and analysis all fail.
# Billing: search = 1 credit, details/byid = 1 credit, details/byaddress = 2.
REALTY_API_KEY=

# ---------------------------------------------------------------------------
# Hosting platform integration
#
# These point at the Manus webdev platform the project was built on. Anything
# that depends on them is noted below; each would need replacing to self-host.
# ---------------------------------------------------------------------------

# OAuth application id and authorisation server. Powers all login and the
# admin role check that gates every credit-spending endpoint.
VITE_APP_ID=
OAUTH_SERVER_URL=

# Platform open id of the project owner. Receives owner notifications, such as
# the nightly saved-search summary.
OWNER_OPEN_ID=

# Built-in LLM gateway. Used only by the weekly AI investment analyst
# (gpt-5-mini primary, gpt-5 on structured-output validation failure). Leave
# blank and the analyst cannot run; nothing else is affected.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# HTTP port. Defaults to 3000.
PORT=3000

# Slice cap for scripts/run-sweep.mjs. Defaults to 200 slices at roughly 80
# seconds each, so about 4.4 hours per invocation.
MAX_SLICES=200

# Umami analytics, substituted into client/index.html at build time. Harmless
# to leave blank — the build warns and carries on.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
